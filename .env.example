# Environment (development, production, test)
NODE_ENV=development

# Application Port (1 - 65535)
APP_PORT=8080

# MongoDB Connection String (Must start with mongodb:// or mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# MongoDB Database Name
MONGODB_DB_NAME=ar_imms_core

# Set these only in the controlled IAM seed job. Inject the password from a
# deployment secret manager; never commit or copy an initial password here.
# IAM_BOOTSTRAP_USERNAME=
# IAM_BOOTSTRAP_EMAIL=
# IAM_BOOTSTRAP_PASSWORD=
# IAM_BOOTSTRAP_USER_ID=

OTEL_SERVICE_NAME=core-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
