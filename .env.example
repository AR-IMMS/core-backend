# Environment (development, production, test)
NODE_ENV=development
# Required HTTPS configuration pointer only; no Control Plane endpoint is implemented yet.
AGENT_CONTROL_PLANE_BASE_URL=https://localhost:8080/api/v1/agent-control
# Development-only placeholder. Generate a private value with `openssl rand -base64 32`.
# Keep the configured key stable until all 24-hour recovery records have expired.
AGENT_ENROLLMENT_RECOVERY_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Application Port (1 - 65535)
APP_PORT=8080

# MongoDB Connection String (Must start with mongodb:// or mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# MongoDB Database Name
MONGODB_DB_NAME=ar_imms_core

# Dedicated replica-set database for integration and E2E tests (must end in _test).
MONGODB_TEST_URI=mongodb://localhost:27017/ar_imms_core_test?replicaSet=rs0

# Set these only in the controlled IAM seed job. Inject the password from a
# deployment secret manager; never commit or copy an initial password here.
# IAM_BOOTSTRAP_USERNAME=
# IAM_BOOTSTRAP_EMAIL=
# IAM_BOOTSTRAP_PASSWORD=
# IAM_BOOTSTRAP_USER_ID=

OTEL_SERVICE_NAME=core-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
