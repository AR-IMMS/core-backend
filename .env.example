# Environment (development, production, test)
NODE_ENV=development
# Required HTTPS configuration pointer only; no Control Plane endpoint is implemented yet.
AGENT_CONTROL_PLANE_BASE_URL=https://localhost:8080/api/v1/agent-control
# Development-only placeholder. Generate a private value with `openssl rand -base64 32`.
# Keep the configured key stable until all 24-hour recovery records have expired.
AGENT_ENROLLMENT_RECOVERY_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Application Port (1 - 65535)
APP_PORT=8080

# MongoDB Connection String (Must start with mongodb:// or mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# MongoDB Database Name
MONGODB_DB_NAME=ar_imms_core

# Dedicated replica-set database for integration and E2E tests (must end in _test).
MONGODB_TEST_URI=mongodb://localhost:27017/ar_imms_core_test?replicaSet=rs0

# P1-A read-only Zammad adapter (not yet composed into CoreModule).
# Set all three in an ignored local file or injected process environment.
# Base URL must be HTTPS, loopback HTTP, or an explicitly approved isolated Docker origin.
TICKET_API_ENABLED=false
# ZAMMAD_TICKET_CUSTOMER_ID=
# ZAMMAD_BASE_URL=http://localhost:8081
# Only for an isolated backend network; exact origin must match ZAMMAD_BASE_URL.
# ZAMMAD_PRIVATE_HTTP_ORIGIN=http://zammad-nginx:8080
# ZAMMAD_API_TOKEN=
# ZAMMAD_EXPECTED_GROUP_ID=
# ZAMMAD_READ_TIMEOUT_MS=5000

# Set these only in the controlled IAM seed job. Inject the password from a
# deployment secret manager; never commit or copy an initial password here.
# IAM_BOOTSTRAP_USERNAME=
# IAM_BOOTSTRAP_EMAIL=
# IAM_BOOTSTRAP_PASSWORD=
# IAM_BOOTSTRAP_USER_ID=

OTEL_SERVICE_NAME=core-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Logical instance generation, reprovision after identity-changing restores.
# ZAMMAD_INSTANCE_KEY=arimms-p0-generation-1

# Required only when enabling the internal external-user access module.
# ZAMMAD_SERVICE_USER_ID=<verified service account ID>
# ZAMMAD_NON_HUMAN_USER_IDS=<JSON array of reviewed non-human/excluded IDs>
