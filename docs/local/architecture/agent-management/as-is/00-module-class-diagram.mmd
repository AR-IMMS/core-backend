AgentManagementModule o-- FleetInvitationController : controllers
AgentManagementModule o-- FleetEnrollmentSyncController : controllers
AgentManagementModule o-- RequestFleetInvitationUseCase : provider
AgentManagementModule o-- SynchronizeFleetEnrollmentUseCase : provider
AgentManagementModule o-- CoordinateNodeLifecycleUseCase : provider
AgentManagementModule o-- FleetManagerAdapterModule : imports
AgentManagementModule o-- MongoFleetEnrollmentOperationStore : binds port
AgentManagementModule o-- MongoFleetBindingProjectionStore : binds port
AgentManagementModule ..> AssetTopologyModule : forwardRef
FleetInvitationController --> RequestFleetInvitationUseCase
FleetEnrollmentSyncController --> SynchronizeFleetEnrollmentUseCase
FleetInvitationController --> IAM : authenticated human and agent:manage
FleetEnrollmentSyncController --> IAM : authenticated human and agent:manage

RequestFleetInvitationUseCase --> NodeEligibilityPort
RequestFleetInvitationUseCase --> BindingProjectionPort
RequestFleetInvitationUseCase --> FleetInstallationPort
RequestFleetInvitationUseCase --> FleetInvitationPort
RequestFleetInvitationUseCase --> EnrollmentOperationPort
RequestFleetInvitationUseCase --> PlatformUnitOfWork
RequestFleetInvitationUseCase --> PlatformOutboxWriter
SynchronizeFleetEnrollmentUseCase --> NodeEligibilityPort
SynchronizeFleetEnrollmentUseCase --> BindingProjectionPort
SynchronizeFleetEnrollmentUseCase --> FleetInstallationPort
SynchronizeFleetEnrollmentUseCase --> FleetInvitationPort
SynchronizeFleetEnrollmentUseCase --> EnrollmentOperationPort
SynchronizeFleetEnrollmentUseCase --> PlatformUnitOfWork
SynchronizeFleetEnrollmentUseCase --> PlatformOutboxWriter
CoordinateNodeLifecycleUseCase ..|> AgentNodeLifecycleCoordination
CoordinateNodeLifecycleUseCase --> FleetNodeEnrollmentGatePort

NodeEligibilityPort --> AssetTopologyAssetQueries : adapter in module
AgentManagementModule ..> AgentBindingQueries : factory adapter
AgentBindingQueries --> BindingProjectionPort
AgentManagementModule ..> AgentNodeLifecycleCoordination : exports contract
AssetTopologyModule --> AgentBindingQueries : lifecycle checks
AssetTopologyModule --> AgentNodeLifecycleCoordination : lifecycle coordination
AssetTopologyModule --> NodeLifecycleOrchestrator
NodeLifecycleOrchestrator --> PlatformUnitOfWork

FleetInvitationHttpAdapter ..|> FleetInvitationPort
FleetInstallationHttpAdapter ..|> FleetInstallationPort
FleetNodeEnrollmentGateHttpAdapter ..|> FleetNodeEnrollmentGatePort
DisabledFleetPorts ..|> FleetInvitationPort
DisabledFleetPorts ..|> FleetInstallationPort
DisabledFleetPorts ..|> FleetNodeEnrollmentGatePort
FleetInvitationHttpAdapter --> FleetHttpClient
FleetInstallationHttpAdapter --> FleetHttpClient
FleetNodeEnrollmentGateHttpAdapter --> FleetHttpClient
FleetHttpClient --> FleetManager : REST over mTLS
FleetManagerAdapterModule o-- FleetHttpClient : configured client or null
FleetManagerAdapterModule o-- FleetInvitationHttpAdapter : chooses adapter
FleetManagerAdapterModule o-- FleetInstallationHttpAdapter : chooses adapter
FleetManagerAdapterModule o-- FleetNodeEnrollmentGateHttpAdapter : chooses adapter

MongoFleetEnrollmentOperationStore ..|> EnrollmentOperationPort
MongoFleetBindingProjectionStore ..|> BindingProjectionPort
MongoFleetEnrollmentOperationStore --> FleetMongoCollection : agent_management_fleet_operations
MongoFleetBindingProjectionStore --> FleetMongoCollection : agent_management_fleet_bindings

note for FleetManager "Fleet owns technical installation identity, enrollment, credentials, registry, authorization, and runtime lifecycle."
note for BindingProjectionPort "Core-owned minimal Asset/Node to Fleet installation association; not Fleet technical registry state."
note for EnrollmentOperationPort "Core-owned invitation orchestration and recovery status."
note for AgentManagementApplication "No Agent Management domain entity, value object, or policy class is implemented. Fleet DTOs and adapter errors are external contracts under application/ports/fleet; enrollment and eligibility errors are application errors."
