FleetManagerAdapterModule o-- FleetInvitationHttpAdapter : or disabled port
FleetManagerAdapterModule o-- FleetInstallationHttpAdapter : or disabled port
FleetManagerAdapterModule o-- FleetNodeEnrollmentGateHttpAdapter : or disabled port
MongoFleetEnrollmentOperationStore ..|> FleetEnrollmentOperationPort
MongoFleetBindingProjectionStore ..|> FleetBindingProjectionPort
MongoFleetEnrollmentOperationStore --> FleetOperationDocument : MongoDB
MongoFleetBindingProjectionStore --> FleetBindingDocument : MongoDB
AgentManagementModule ..> MongoFleetEnrollmentOperationStore : binds port
AgentManagementModule ..> MongoFleetBindingProjectionStore : binds port
AgentManagementModule ..> NodeEligibilityPort : factory adapter
NodeEligibilityPort --> AssetTopologyAssetQueries : public contract
AgentManagementModule ..> AgentBindingQueries : factory adapter
AgentBindingQueries --> FleetBindingProjectionPort : query projection
AgentManagementModule ..> AgentNodeLifecycleCoordination : public contract
AssetTopologyModule --> AgentBindingQueries : Asset lifecycle checks
AssetTopologyModule --> AgentNodeLifecycleCoordination : Node lifecycle coordination
AssetTopologyModule --> NodeLifecycleOrchestrator
NodeLifecycleOrchestrator --> PlatformUnitOfWork

note for FleetManager "Fleet owns technical Agent identity, credentials, registry, enrollment, authorization, and runtime lifecycle."
note for MongoFleetBindingProjectionStore "Contains only Core's association projection; it is not a technical registry or credential store."
note for AgentManagementModule "No Core-owned registration, access lifecycle, registry, or recovery cipher is wired. Historical migration entries for removed collections remain to preserve migration history and ordering."
